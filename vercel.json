{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/coseg",
      "destination": "/public/coseg/index.html"
    },
    {
      "source": "/coseg/(.*)",
      "destination": "/public/coseg/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
