# ==============================================================================
# CONFIGURACIÓN DE ENTORNO: SISTEMA DE BENEFICIOS Y COMBOS (MIPPCI)
# Copia este archivo como .env y completa los datos de tu proyecto en Supabase
# ==============================================================================

# 1. Configuración del Servidor
PORT=3000
NODE_ENV=development

# 2. Conexión Supabase (Obtén estos datos en: Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_public_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_secret_key_aqui

# 3. Conexión Directa PostgreSQL (Opcional - Project Settings -> Database -> Connection String)
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.TU_PROYECTO.supabase.co:5432/postgres

# 4. Claves Criptográficas y Webhooks de Nómina
PAYROLL_WEBHOOK_SECRET=mippci_bolsa_secure_secret_key_2026
RP_NAME="Sistema Bienestar Social - Beneficios Alimenticios (MIPPCI)"
RP_ID="localhost"
SESSION_JWT_SECRET=tu_secreto_jwt_de_sesion_aqui
SYSTEM_RESET_SECRET=tu_pin_o_clave_de_reinicio_aqui
SYSTEM_RESET_PHRASE="REINICIAR SISTEMA"

