  "cards": [
    {
      "dot": "emerald",
      "title": "Soberanía de Datos e Integridad Referencial",
      "items": [
        "Claves foráneas estrictas con SQLite PRAGMA foreign_keys = ON y réplica remota en Supabase",
        "Índice relacional compuesto idx_unique_daily_claim en deliveries impide doble despacho en la misma jornada",
        "Relación 1:N opcional entre trabajadores y credenciales FIDO2 para enrolamiento progresivo de dispositivos"
      ]
    },
    {
      "dot": "rose",
      "title": "Idempotencia y Prevención de Concurrencia",
      "items": [
        "Tabla idempotency_keys retiene tokens UUID de cada petición durante 24 horas",
        "Reintentos automáticos de la PWA ante cortes de red reciben respuesta idéntica sin duplicar transacciones",
        "Transacciones ACID WAL (Write-Ahead Logging) garantizan consistencia con latencia sub-milisegundo"
      ]
    },
    {
      "dot": "cyan",
      "title": "Auditoría y Trazabilidad Criptográfica",
      "items": [
        "Registro inmutable con crypto_signature para validar actas de despacho ante entes contralores",
        "Bandera synced_supabase orquesta el estado de sincronización bidireccional tras trabajo offline",
        "Tabla audit_logs rastrea cada inicio de sesión, cambio de nómina y consulta administrativa con IP y timestamp"
      ]
    }
  ]
